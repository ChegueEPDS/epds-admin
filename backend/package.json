{
  "name": "epds-admin-backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "check": "find src -name '*.js' -print0 | xargs -0 -n1 node --check",
    "test": "node --test test/*.test.js",
    "migrate:performance": "node scripts/migrate-performance.js",
    "postgres:migrate": "node scripts/migrate-mongodb-to-postgres.js all",
    "postgres:schema": "node scripts/migrate-mongodb-to-postgres.js schema",
    "postgres:project": "node scripts/migrate-mongodb-to-postgres.js project",
    "postgres:verify": "node scripts/migrate-mongodb-to-postgres.js verify",
    "migrate:domain-customers": "node scripts/migrate-domain-customer-monitoring.js",
    "start:domain-probe": "node scripts/domain-probe-server.js"
  },
  "dependencies": {
    "@azure/identity": "^4.12.0",
    "@azure/storage-blob": "^12.33.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "axios": "^1.8.2",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^2.2.0",
    "pdfkit": "^0.19.1",
    "pg": "8.16.3",
    "undici": "^7.15.0",
    "yauzl": "3.2.0"
  }
}
