NODE_ENV=development
PORT=4301
MONGODB_URI=mongodb://127.0.0.1:27017/epds

# Local file logs. In Azure App Service, /home/LogFiles is persistent and visible in Log stream / Kudu.
LOG_DIR=logs
APP_LOG_FILE=
ERROR_LOG_FILE=

# Must match the existing Backend auth settings when sharing users/sessions.
JWT_SECRET=local-dev-secret-change-me
JWT_AUDIENCE=epds-admin-api
JWT_ISSUER=epds-admin-backend
ACCESS_TOKEN_TTL_WEB=15m
REFRESH_TOKEN_TTL_WEB=12h
SESSION_ABSOLUTE_TTL_WEB=24h
REFRESH_ROTATION_GRACE=10s

# Browser cookie/session behavior.
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_REQUIRE_CSRF=false
CORS_ALLOWED_ORIGINS=http://localhost:4300

# Microsoft Graph application permissions for mailbox read/send.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
MICROSOFT_TOKEN_ISSUERS=
EPDS_ADMIN_ALLOWED_EMAIL_DOMAINS=epds.hu,robex.hu
EPDS_ADMIN_GLOBAL_TENANT_NAME=epds
EPDS_ADMIN_DEFAULT_TENANT_NAME=epds-admin
MAIL_SENDER_UPN=
MAIL_SAVE_TO_SENT=true
MAIL_INLINE_LOGO=false
MAIL_INLINE_LOGO_TIMEOUT_MS=5000

# Optional Google PageSpeed Insights API key for Domain Health PageSpeed scans.
PAGESPEED_API_KEY=
PAGESPEED_TIMEOUT_MS=90000
PAGESPEED_DAILY_RUNS=1
PAGESPEED_INITIAL_DELAY_MS=60000

# Daily Domain Health status report. Runs at 07:00 Europe/Budapest by default.
DOMAIN_DAILY_REPORT_ENABLED=true
DOMAIN_DAILY_REPORT_TO=kovacs@epds.hu
DOMAIN_DAILY_REPORT_TIME_ZONE=Europe/Budapest
DOMAIN_DAILY_REPORT_HOUR=7
DOMAIN_DAILY_REPORT_MINUTE=0
