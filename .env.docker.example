# Host ports consumed by the VPS reverse proxy.
FRONTEND_HOST_PORT=4300
BACKEND_HOST_PORT=4301

# Set this to the HDD mount directory on the VPS, for example /mnt/storage/epds/files.
FILE_STORAGE_HOST_PATH=./data/files

MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-me-with-a-long-random-value

JWT_SECRET=change-me-with-a-long-random-value
JWT_AUDIENCE=epds-admin-api
JWT_ISSUER=epds-admin-backend
AUTH_COOKIE_DOMAIN=.epds.hu
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_REQUIRE_CSRF=true
CORS_ALLOWED_ORIGINS=https://admin.epds.hu

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
MICROSOFT_TOKEN_ISSUERS=
EPDS_ADMIN_ALLOWED_EMAIL_DOMAINS=epds.hu,robex.hu
MAIL_SENDER_UPN=

INTEGRATION_SECRET_ENCRYPTION_KEY=
PAGESPEED_API_KEY=
